        <mxCell id="ptN" value="N  |  ... |  ...         |  ... | ..." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#000000;fontSize=10;align=left;spacingLeft=8;fontColor=#000000;" vertex="1" parent="1">
